# -----------------------------------------------------------------------------
# TATA AI — Environment Variables
# Copy this file to `.env.local` and fill in the values before running the app.
#   cp .env.example .env.local
# -----------------------------------------------------------------------------

# -------------------------------
# Google Gemini / Vertex AI
# -------------------------------
# API key used by the @google/genai SDK for all Gemini-powered routes
# (chat, script generation, thumbnails, video, transcription, etc.).
# Get one at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: only required if you switch `vertexai: true` to use a GCP project
# instead of an API key. See app/api/generate-video/route.ts.
# GOOGLE_CLOUD_PROJECT_ID=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# -------------------------------
# ElevenLabs (Text-to-Speech / Voice Cloning)
# -------------------------------
# Used by the @elevenlabs/elevenlabs-js SDK (voice clone + TTS routes).
# Get one at: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here

# -------------------------------
# UploadThing (file hosting for generated images/audio/video)
# -------------------------------
# Used by the `uploadthing` SDK (lib/upload.ts, app/api/uploadthing).
# Create an app at: https://uploadthing.com/dashboard
UPLOADTHING_TOKEN=your-uploadthing-token-here

# -------------------------------
# App URL
# -------------------------------
# Base URL used by server-side code (e.g. app/api/execute-tool) to call
# back into this app's own API routes. In development this is localhost;
# in production set it to your deployed origin (e.g. https://tataai.app).
NEXT_PUBLIC_APP_URL=http://localhost:3000
